    <string name="voice_input_cancel">Cancel</string>
    <string name="voice_input_setup_needed">Finish setting up Voicemator first. Tap here to open it.</string>
    <string name="setup_voice_input_title">Voice input for keyboards</string>
    <string name="setup_voice_input_body">Lets keyboards with a voice key use Voicemator. Turn on Voicemator voice input in the keyboard settings. In FUTO Keyboard, also open Settings → Voice input and turn on “Disable built-in voice input”. Then tap the keyboard\'s mic key: dictation starts, and stopping types the text and returns to your keyboard.</string>

    <string name="history_mode_full">Full history</string>
    <string name="history_mode_full_body">Keeps the text of each dictation, to read back and copy, and statistics.</string>
    <string name="history_mode_statistics">Statistics only</string>
    <string name="history_mode_statistics_body">Keeps only word count, length and time. Statistics work, but nothing you said can be read back.</string>
    <string name="history_mode_off">Off</string>
    <string name="history_mode_off_body">Keeps nothing.</string>
    <string name="history_statistics_only">Only statistics are kept: dictations are counted, but their text is not saved or shown.</string>
    <string name="history_mode_change_title">Remove saved texts too?</string>
    <string name="history_mode_change_body">New dictations will not keep their text. Texts saved so far can be removed now; their statistics stay.</string>
    <string name="history_remove_texts">Remove texts, keep statistics</string>
    <string name="history_keep_texts">Keep them</string>
    <string name="history_remove_texts_confirm_title">Remove all saved texts?</string>
    <string name="history_remove_texts_confirm_body">The text of every saved dictation will be deleted. Statistics stay. This cannot be undone.</string>

